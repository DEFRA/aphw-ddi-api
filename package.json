{
  "name": "aphw-ddi-api",
  "version": "0.88.3",
  "description": "API to manage CRUD / query functions for dangerous dogs register",
  "homepage": "https://github.com/DEFRA/aphw-ddi-api",
  "main": "app/index.js",
  "scripts": {
    "pretest": "npm run test:lint",
    "test": "jest --runInBand --forceExit --silent=\"false\"",
    "test:parallel": "jest --forceExit --silent=\"false\"",
    "test:unit": "jest --testPathPatterns=test/unit --coverage=false",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:lint": "standard",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch app/index.js"
  },
  "author": "Defra",
  "contributors": [
    "Shaun Fitzsimons shaun.fitzsimmons@defra.gov.uk",
    "Steve Dickinson steve.dickinson@defra.gov.uk"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.17.0",
    "@hapi/basic": "^7.0.2",
    "@hapi/catbox": "^12.1.1",
    "@hapi/catbox-redis": "^7.1.0",
    "@hapi/hapi": "^21.4.10",
    "@hapi/inert": "^7.1.2",
    "@hapi/jwt": "^3.2.0",
    "@hapi/vision": "^7.0.3",
    "@hapi/wreck": "^18.1.0",
    "@joi/date": "^2.1.0",
    "applicationinsights": "^3.16.0",
    "braces": "^3.0.3",
    "date-fns": "^3.2.0",
    "dayjs": "^1.11.10",
    "ffc-messaging": "^2.10.10",
    "hapi-swagger": "^17.2.1",
    "joi": "^17.13.8",
    "js-levenshtein": "^1.1.6",
    "json-difference": "^1.16.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "read-excel-file": "^5.8.1",
    "sequelize": "^6.37.8",
    "talisman": "^1.1.4",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@hapi/catbox-memory": "^6.0.2",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-when": "^3.6.0",
    "nodemon": "^3.0.1",
    "standard": "^17.1.2"
  },
  "standard": {
    "globals": [
      "describe",
      "beforeEach",
      "expect",
      "test",
      "afterEach",
      "jest",
      "beforeAll",
      "afterAll"
    ]
  },
  "overrides": {
    "uuid": "$uuid",
    "ffc-messaging": {
      "joi": "^18.3.1",
      "@azure/identity": "4.14.1"
    },
    "glob@^10": "^14.0.3",
    "glob@^13": "^14.0.3",
    "minimatch@^10": "^11.0.4"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  }
}
